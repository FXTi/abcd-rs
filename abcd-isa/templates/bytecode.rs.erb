%   is_jump = group.first.jump?
%   ops = group.first.operands
%   if ops.empty?
            Bytecode::<%= vname %> => 0,
%   else
%     pat_vars = []
%     assignments = []
%     ops.each_with_index do |op, i|
%       vn = "a#{i}"
%       pat_vars << vn
%       if is_jump && op.imm?
%         assignments << "args[#{i}] = #{vn}.0 as i64;"
%       elsif op.reg?
%         assignments << "args[#{i}] = #{vn}.0 as i64;"
%       elsif op.id?
%         assignments << "args[#{i}] = #{vn}.0 as i64;"
%       else
%         assignments << "args[#{i}] = #{vn}.0;"
%       end
%     end
            Bytecode::<%= vname %>(<%= pat_vars.join(', ') %>) => {
%     assignments.each do |a|
                <%= a %>
%     end
                <%= ops.size %>
            }
%   end
% end
        };
        (op, args, n)
    }

    /// Set the jump target label.
    #[inline]
    pub fn set_label(&mut self, label: Label) {
        match self {
% mnemonic_groups.each do |mnemonic, group|
%   next unless group.first.jump?
%   vname = mnemonic_variant_name(mnemonic)
%   ops = group.first.operands
%   label_idx = ops.index { |op| op.imm? }
%   next unless label_idx
%   pats = ops.each_with_index.map { |_, i| i == label_idx ? 'l' : '_' }
            Bytecode::<%= vname %>(<%= pats.join(', ') %>) => *l = label,
% end
            _ => {}
        }
    }

    /// Jump target [`Label`] if this instruction is a jump, `None` otherwise.
    #[inline]
    pub const fn jump_label(&self) -> Option<Label> {
        match *self {
% mnemonic_groups.each do |mnemonic, group|
%   next unless group.first.jump?
%   vname = mnemonic_variant_name(mnemonic)
%   ops = group.first.operands
%   label_idx = ops.index { |op| op.imm? }
%   next unless label_idx
%   pats = ops.each_with_index.map { |_, i| i == label_idx ? 'l' : '_' }
            Bytecode::<%= vname %>(<%= pats.join(', ') %>) => Some(l),
% end
            _ => None,
        }
    }

    /// Index of the label operand in [`emit_args`](Self::emit_args) output.
    ///
    /// Returns `Some(idx)` for jump instructions, `None` otherwise.
    #[inline]
    pub const fn jump_label_arg_index(&self) -> Option<usize> {
        match self {
% mnemonic_groups.each do |mnemonic, group|
%   next unless group.first.jump?
%   vname = mnemonic_variant_name(mnemonic)
%   ops = group.first.operands
%   label_idx = ops.index { |op| op.imm? }
%   next unless label_idx
            Bytecode::<%= vname %>(..) => Some(<%= label_idx %>),
% end
            _ => None,
        }
    }
}

// ============================================================================
// Pure-Rust Modern ISA Decode, Entity Slot Lookup & Encode Classification
// ============================================================================

/// Read the 1- or 2-byte modern (`24.0.0.0`) opcode at `bytes[0..]`.
#[inline]
fn read_modern_opcode(bytes: &[u8]) -> Result<u16, ModernDecodeFault> {
    let Some(&b0) = bytes.first() else {
        return Err(ModernDecodeFault::Truncated);
    };
    if b0 >= MIN_PREFIX_OPCODE {
        let Some(&b1) = bytes.get(1) else {
            return Err(ModernDecodeFault::Truncated);
        };
        Ok(((b1 as u16) << 8) | (b0 as u16))
    } else {
        Ok(b0 as u16)
    }
}

/// Look up the `(byte_offset, byte_width)` of the `ordinal`-th entity-ID operand
/// in the modern (`24.0.0.0`) instruction starting at `bytes`.
///
/// Validates both opcode assignment and full instruction byte length before
/// inspecting operand slots.
pub fn modern_entity_id_slot(bytes: &[u8], ordinal: u32) -> Result<(usize, u8), ModernEntitySlotFault> {
    let opcode = read_modern_opcode(bytes).map_err(|_| ModernEntitySlotFault::InvalidInstruction)?;
    match opcode {
% Panda.instructions.each do |insn|
%   size = insn.format.size
%   id_ops = insn.operands.select(&:id?)
        <%= insn.opcode_idx %> => {
            if bytes.len() < <%= size %> {
                return Err(ModernEntitySlotFault::InvalidInstruction);
            }
%   if id_ops.empty?
            let _ = ordinal;
            Err(ModernEntitySlotFault::MissingOperand)
%   else
            match ordinal {
%     id_ops.each_with_index do |op, idx|
%       raise "unaligned entity id in #{insn.opcode}" unless (op.offset % 8 == 0) && [8, 16, 32].include?(op.width)
                <%= idx %> => Ok((<%= op.offset / 8 %>, <%= op.width / 8 %>)),
%     end
                _ => Err(ModernEntitySlotFault::MissingOperand),
            }
%   end
        }
% end
        _ => Err(ModernEntitySlotFault::InvalidInstruction),
    }
}

impl Bytecode {
    /// Pure-Rust modern (`24.0.0.0`) single-instruction decoder.
    ///
    /// Returns `(instruction, byte_len, raw_jump_offset)` where jump operands
    /// hold placeholder `Label(0)` and `raw_jump_offset` carries the signed
    /// byte displacement relative to the start of the instruction.
    pub fn decode_modern(bytes: &[u8]) -> Result<(Self, usize, Option<i64>), ModernDecodeFault> {
        let opcode = read_modern_opcode(bytes)?;
        match opcode {
% Panda.instructions.each do |insn|
%   vname = mnemonic_variant_name(insn.mnemonic)
%   size = insn.format.size
%   is_jump = insn.jump?
%   ops = insn.operands
            <%= insn.opcode_idx %> => {
                let Some(b) = bytes.get(..<%= size %>) else {
                    return Err(ModernDecodeFault::Truncated);
                };
%   if ops.empty?
                let _ = b;
                Ok((Bytecode::<%= vname %>, <%= size %>, None))
%   else
%     field_exprs = []
%     jump_expr = nil
%     ops.each do |op|
%       if is_jump && op.imm?
%         jump_expr = decode_operand_expr(op, true)
%         field_exprs << 'Label(0)'
%       else
%         field_exprs << decode_operand_expr(op, false)
%       end
%     end
%     if is_jump && jump_expr
                let raw_imm = <%= jump_expr %>;
                Ok((Bytecode::<%= vname %>(<%= field_exprs.join(', ') %>), <%= size %>, Some(raw_imm)))
%     else
                Ok((Bytecode::<%= vname %>(<%= field_exprs.join(', ') %>), <%= size %>, None))
%     end
%   end
            }
% end
            _ => Err(ModernDecodeFault::InvalidOpcode),
        }
    }

    /// Pure-Rust instruction encoder & jump classifier.
    ///
    /// Validates every non-label operand against the mnemonic's maximum legal
    /// storage width (`Err(())` on overflow/underflow) and packs non-jump
    /// instructions into their narrowest legal ISA format, matching upstream
    /// `BytecodeEmitter` format selection bit-for-bit.
    #[allow(clippy::too_many_lines, reason = "generated per-mnemonic dispatch")]
    pub fn classify_for_encode(&self) -> Result<EncodeInsnKind, ()> {
        match *self {
% mnemonic_groups.each do |mnemonic, group|
%   vname = mnemonic_variant_name(mnemonic)
%   first = group.first
%   ops = first.operands
%   sorted_group = group.sort_by { |ins| ins.format.size }
%   if first.jump?
%     sorted_group.each { |ins| raise "prefixed jump unsupported: #{ins.opcode}" if ins.format.prefixed? }
%     ins8 = sorted_group.find { |ins| ins.operands.find(&:imm?).width == 8 }
%     ins16 = sorted_group.find { |ins| ins.operands.find(&:imm?).width == 16 }
%     ins32 = sorted_group.find { |ins| ins.operands.find(&:imm?).width == 32 }
%     raise "missing imm8/imm16 jump in #{mnemonic}" unless ins8 && ins16
%     wide_expr = if ins32
%       "WideJumpKind::NativeImm32(#{format('0x%02x', ins32.opcode_idx)})"
%     else
%       inv_mnem = INVERT_JUMP_MNEMONIC.fetch(mnemonic) { raise "No inverted mnemonic for jump #{mnemonic}" }
%       inv_ins8 = mnemonic_groups.fetch(inv_mnem).find { |ins| ins.operands.find(&:imm?).width == 8 }
%       raise "Missing imm8 inverted jump for #{inv_mnem}" unless inv_ins8 && !inv_ins8.format.prefixed?
%       if ops.size == 1
%         "WideJumpKind::InvertImm8(#{format('0x%02x', inv_ins8.opcode_idx)})"
%       elsif ops.size == 2 && ops[0].reg? && ops[0].width == 8
%         "WideJumpKind::InvertV8Imm8(#{format('0x%02x', inv_ins8.opcode_idx)})"
%       else
%         raise "Unexpected jump signature for #{mnemonic}"
%       end
%     end
%     if ops.size == 1 && ops[0].imm?
            Bytecode::<%= vname %>(target) => Ok(EncodeInsnKind::Jump(JumpEncodeMeta {
                target,
                reg: None,
                op_imm8: <%= format("0x%02x", ins8.opcode_idx) %>,
                op_imm16: <%= format("0x%02x", ins16.opcode_idx) %>,
                wide: <%= wide_expr %>,
            })),
%     elsif ops.size == 2 && ops[0].reg? && ops[1].imm?
            Bytecode::<%= vname %>(reg, target) => {
                if reg.0 > 0xff {
                    return Err(());
                }
                Ok(EncodeInsnKind::Jump(JumpEncodeMeta {
                    target,
                    reg: Some(reg.0 as u8),
                    op_imm8: <%= format("0x%02x", ins8.opcode_idx) %>,
                    op_imm16: <%= format("0x%02x", ins16.opcode_idx) %>,
                    wide: <%= wide_expr %>,
                }))
            }
%     else
%       raise "Unsupported jump operand layout in #{mnemonic}"
%     end
%   elsif ops.empty?
%     ins = sorted_group.first
            Bytecode::<%= vname %> => {
                let mut bytes = [0u8; 16];
                bytes[0] = <%= format("0x%02x", ins.opcode_idx & 0xff) %>;
%     if ins.format.prefixed?
                bytes[1] = <%= format("0x%02x", (ins.opcode_idx >> 8) & 0xff) %>;
%     end
                Ok(EncodeInsnKind::Fixed {
                    bytes,
                    len: <%= ins.format.size %>,
                })
            }
%   else
%     pat_vars = ops.each_with_index.map { |_, i| "a#{i}" }
%     widest_checks = []
%     ops.each_with_index do |op, i|
%       max_w = sorted_group.map { |ins| ins.operands[i].width }.max
%       cond = operand_fits_cond("a#{i}", op, max_w)
%       widest_checks << cond if cond
%     end
            Bytecode::<%= vname %>(<%= pat_vars.join(', ') %>) => {
%     unless widest_checks.empty?
                if !(<%= widest_checks.join(' && ') %>) {
                    return Err(());
                }
%     end
%     sorted_group[0...-1].each do |ins|
%       fit_conds = []
%       ins.operands.each_with_index do |op, i|
%         max_w = sorted_group.map { |g_ins| g_ins.operands[i].width }.max
%         next if op.width == max_w
%         cond = operand_fits_cond("a#{i}", op, op.width)
%         fit_conds << cond if cond
%       end
                if <%= fit_conds.empty? ? 'true' : fit_conds.join(' && ') %> {
                    let mut bytes = [0u8; 16];
                    bytes[0] = <%= format("0x%02x", ins.opcode_idx & 0xff) %>;
%       if ins.format.prefixed?
                    bytes[1] = <%= format("0x%02x", (ins.opcode_idx >> 8) & 0xff) %>;
%       end
%       ins.operands.each_with_index do |op, i|
                    <%= pack_operand_stmt('bytes', "a#{i}", op) %>
%       end
                    return Ok(EncodeInsnKind::Fixed {
                        bytes,
                        len: <%= ins.format.size %>,
                    });
                }
%     end
%     ins = sorted_group.last
                let mut bytes = [0u8; 16];
                bytes[0] = <%= format("0x%02x", ins.opcode_idx & 0xff) %>;
%     if ins.format.prefixed?
                bytes[1] = <%= format("0x%02x", (ins.opcode_idx >> 8) & 0xff) %>;
%     end
%     ins.operands.each_with_index do |op, i|
                <%= pack_operand_stmt('bytes', "a#{i}", op) %>
%     end
                Ok(EncodeInsnKind::Fixed {
                    bytes,
                    len: <%= ins.format.size %>,
                })
            }
%   end
% end
        }
    }

}

